# =============================================================================
# SecurePAM Environment Configuration
# =============================================================================
# Copy this file to .env and update values for your environment.
# NEVER commit .env with real credentials.
# =============================================================================

# --- Application ---
APP_NAME=SecurePAM
APP_VERSION=0.1.0
ENVIRONMENT=development
# DEV_MODE=true is refused unless ENVIRONMENT is development or test.
DEV_MODE=true
DEBUG=true
LOG_LEVEL=INFO
# Production refuses this placeholder; use >= 32 random chars (e.g. `openssl rand -hex 32`).
SECRET_KEY=change-this-to-a-secure-random-string-in-production

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
API_V1_PREFIX=/api/v1

# --- Database (PostgreSQL) ---
POSTGRES_USER=securepam
POSTGRES_PASSWORD=securepam_dev_password
POSTGRES_DB=securepam
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://securepam:securepam_dev_password@postgres:5432/securepam

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# --- Identity Provider (Keycloak) ---
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=securepam
KEYCLOAK_CLIENT_ID=securepam-app
KEYCLOAK_CLIENT_SECRET=change-this-in-production
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# --- Secret provider / OpenBao ---
# SECRET_PROVIDER=mock    -> fake credentials only (refused when ENVIRONMENT=production)
# SECRET_PROVIDER=openbao -> OPENBAO_ADDR and OPENBAO_TOKEN are REQUIRED; startup
#                            fails if missing/invalid. There is no fallback to mock.
# OPENBAO_TOKEN must be the RESTRICTED application token (securepam-read policy),
# never a root/admin token. Put the real value only in backend/.env (git-ignored).
SECRET_PROVIDER=mock
OPENBAO_ADDR=http://127.0.0.1:8200
OPENBAO_MOUNT_POINT=secret
OPENBAO_TOKEN=
OPENBAO_SECRET_PATH_PREFIX=securepam
OPENBAO_CONNECT_TIMEOUT_SECONDS=3
OPENBAO_REQUEST_TIMEOUT_SECONDS=5
# Optional CA bundle path when OpenBao is served over TLS with a private CA
OPENBAO_CA_CERT=

# --- Vault (legacy names still read by older docs) ---
# The lab profile runs OpenBao, not HashiCorp Vault. OPENBAO_DEV_ROOT_TOKEN_ID
# bootstraps that dev server only. Never copy it into OPENBAO_TOKEN.
OPENBAO_DEV_ROOT_TOKEN_ID=lab-dev-root-token
VAULT_URL=http://vault:8200
VAULT_TOKEN=
VAULT_MOUNT_PATH=secret
VAULT_ENABLED=false

# --- Apache Guacamole ---
GUACAMOLE_URL=http://guacamole:8080/guacamole
GUACAMOLE_ADMIN_USER=guacadmin
GUACAMOLE_ADMIN_PASSWORD=guacadmin
GUACD_HOST=guacd
GUACD_PORT=4822

# --- NGINX Gateway ---
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# --- Web Gateway (Member 11: Web Gateway & Browser Isolation) ---
# Internal Docker service names — not sensitive, but do not expose to public.
GATEWAY_BACKEND_HOST=backend
GATEWAY_BACKEND_PORT=8000
GATEWAY_TEST_UPSTREAM=backend:8000
# Pre-shared secret between NGINX, browser isolation and the FastAPI auth_request
# hook. Required for the gateway profile: at least 32 characters of A-Z a-z 0-9 _ -.
# While unset, the gateway containers refuse to start and the hook rejects everything.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
GATEWAY_AUTH_TOKEN=
# Secure flag on the gateway credential cookie. Browsers accept it on
# http://localhost; set false only for another plain-HTTP lab host.
GATEWAY_COOKIE_SECURE=true
# Host port where the NGINX gateway container listens (maps to container port 7000).
# NOTE (macOS Port 7000 Conflict): macOS Monterey/Ventura/Sonoma/Sequoia bind port 7000
# by default for AirPlay Receiver (ControlCenter). If running on macOS, override to 17000:
# GATEWAY_PORT=17000
GATEWAY_PORT=7000
# Shared volume mount path in the backend container (matches gateway_config volume)
GATEWAY_CONFIG_DIR=/gateway-config
# URL of the NGINX internal control server — used to verify routing (not for reload)
GATEWAY_NGINX_CONTROL_URL=http://securepam-nginx-gateway:8081
# Host-side port for the NGINX control server (127.0.0.1 only — not public)
GATEWAY_CONTROL_HOST_PORT=18081
GATEWAY_BROWSER_ISOLATION_URL=http://browser-isolation:6080
BROWSER_ISOLATION_HOST_PORT=16080

# --- Wazuh SIEM ---
WAZUH_URL=https://wazuh:55000
WAZUH_USER=wazuh-wui
WAZUH_PASSWORD=change-this
WAZUH_ENABLED=false

# --- Monitoring ---
PROMETHEUS_ENABLED=false
GRAFANA_ADMIN_PASSWORD=admin

# --- Session Defaults ---
DEFAULT_SESSION_TIMEOUT=30
MAX_SESSION_TIMEOUT=480
JIT_DEFAULT_DURATION=30
JIT_MAX_DURATION=480

# --- Security ---
TOKEN_EXPIRY_MINUTES=60
REFRESH_TOKEN_EXPIRY_DAYS=7
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_AUTH_PER_MINUTE=10

# --- Recordings ---
RECORDING_STORAGE_PATH=/data/recordings
RECORDING_RETENTION_DAYS=90
